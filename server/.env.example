# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.

# Local disposable database. For hosted Supabase, copy the direct or session
# pooler URI from the project's Connect panel. Keep it server-side only.
# Do not append sslmode: the server config enforces TLS and certificate checks.
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/cartcheck

# Guarded tests against an approved Supabase development project also require
# its independent 20-character project ref. Leave unset for normal app use.
# CARTCHECK_TEST_PROJECT_REF=your-development-ref

# Optional CA certificate file for a hosted database, if Node does not trust
# its certificate chain. Download the database root certificate from Supabase.
# SSL_CA_FILE=C:/path/to/supabase-ca.crt
DB_POOL_MAX=5

# Comma-separated, no trailing slash, no path. An origin is scheme + host + port.
CORS_ORIGINS=http://localhost:5173

# Set to production on your host. Express and several libraries behave better,
# including not sending stack traces to your users.
NODE_ENV=development

# Do NOT set PORT locally or on the host. The host sets it for you.
