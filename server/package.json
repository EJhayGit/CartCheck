{
  "name": "cartcheck-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env --watch server.js",
    "db:migrate": "node --env-file=.env db/run.js migrate",
    "db:seed": "node --env-file=.env db/run.js seed",
    "db:verify": "node --env-file=.env db/verify.js",
    "db:preflight": "node --env-file=.env db/preflight.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "pg": "^8.13.1"
  }
}
