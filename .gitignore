# Secrets. Never commit these.
.env
.env.*
!.env.example
server/*.crt

# Dependencies and build output
node_modules/
dist/
build/

# Database dumps: a full plain-text copy of your data
*.dump
backup*.sql

# Editor and OS noise
.DS_Store
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
log.md
server/.test-runs/

# Local documentation archive and generated review evidence
/archive/
/docs/design/*-preview/
/docs/design/*-review/
/docs/assets/mockups/
