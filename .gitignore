# Secrets. Never commit these.
.env
.env.*
!.env.example
server/*.crt

# Dependencies and build output
node_modules/
dist/
build/

# Database dumps: a full plain-text copy of your data
*.dump
backup*.sql

# Editor and OS noise
.DS_Store
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
server/.test-runs/

# Generated review evidence (server/db/testMultipleListsLocal.js)
/docs/design/*-preview/
/docs/design/*-review/
